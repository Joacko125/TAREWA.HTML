---
// Footer global, idéntico en todas las páginas.
// El logo (logo.avif) va sobre un chip claro: su tinta oscura no leería
// directamente sobre el grafito del footer, y así conserva los colores de marca.
// Tres columnas sobrias: marca · otras marcas del grupo · redes sociales.
// Otras marcas: carrusel continuo de logos en cajas iguales (estilos y
// animación en global.css). `url: null` = marca sin sitio cargado: se muestra
// el logo sin enlace (hoy Fusionar).
const anio = new Date().getFullYear();

const otrasMarcas = [
  { nombre: 'Bancos de Carga', url: 'https://www.bancosdecarga.com.ar/', logo: '/assets/marcas/logo-bancos-de-carga.avif', ancho: 300, alto: 67 },
  { nombre: 'Fusionar', url: null, logo: '/assets/marcas/logo-fusionar.avif', ancho: 300, alto: 48 },
  { nombre: 'Instafire', url: 'https://instafire.com.ar/', logo: '/assets/marcas/logo-instafire.avif', ancho: 300, alto: 98 },
  { nombre: 'Scirocco', url: 'https://scirocco.com.ar/', logo: '/assets/marcas/logo-scirocco.avif', ancho: 300, alto: 65 },
];
// El track repite la lista 4 veces: cada mitad (2 vueltas = 1312px) es más
// ancha que el carrusel en desktop (~720px), así el loop a -50% es continuo.
// Solo la primera vuelta es "real"; las demás son decorativas: ocultas a
// lectores de pantalla y fuera del tabulado.
const copias = [false, true, true, true];

const redes = [
  { nombre: 'LinkedIn', url: 'https://www.linkedin.com/company/tarewa' },
  { nombre: 'Facebook', url: 'https://www.facebook.com/Tarewa1964' },
];
---

<!-- FOOTER -->
<footer>
  <div class="filamento"></div>
  <div class="footer-inner">

    <div class="footer-main">
      <div class="footer-col footer-col-marca">
        <a href="/" class="footer-brand" aria-label="TAREWA — inicio">
          <img src="/assets/logo.avif" alt="TAREWA" width="1174" height="648" />
        </a>
        <p class="footer-desc">Fabricantes de resistencias eléctricas industriales desde 1964. Buenos Aires, Argentina.</p>
      </div>

      <nav class="footer-col footer-col-marcas" aria-label="Nuestras otras marcas">
        <p class="footer-title">Nuestras otras marcas</p>
        <div class="footer-marcas">
          <ul class="footer-marcas-track">
            {copias.map((esCopia) => otrasMarcas.map((marca) => (
              <li class="footer-marcas-item" aria-hidden={esCopia ? 'true' : undefined}>
                {marca.url ? (
                  <a class="footer-marca" href={marca.url} target="_blank" rel="noopener" tabindex={esCopia ? -1 : undefined} draggable="false">
                    <img src={marca.logo} alt={marca.nombre} width={marca.ancho} height={marca.alto} loading="lazy" decoding="async" draggable="false" />
                  </a>
                ) : (
                  <span class="footer-marca">
                    <img src={marca.logo} alt={marca.nombre} width={marca.ancho} height={marca.alto} loading="lazy" decoding="async" draggable="false" />
                  </span>
                )}
              </li>
            )))}
          </ul>
        </div>
      </nav>

      <div class="footer-col">
        <p class="footer-title">Seguinos</p>
        <div class="footer-social">
          <a href={redes[0].url} target="_blank" rel="noopener" aria-label="LinkedIn de TAREWA">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/>
            </svg>
          </a>
          <a href={redes[1].url} target="_blank" rel="noopener" aria-label="Facebook de TAREWA">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.09 24 18.1 24 12.07z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {anio} TAREWA · Resistencias Industriales · Buenos Aires, Argentina</p>
    </div>

  </div>
</footer>

<!-- Carrusel de marcas: arrastrable con mouse y dedo. Controla la misma
     animación CSS (Web Animations API): mientras se arrastra se pausa y se
     mueve su currentTime; al soltar se retoma. La pausa por hover / foco
     también la maneja este script (una vez que JS toca play/pause, el
     animation-play-state de CSS deja de aplicar). Con prefers-reduced-motion
     no hay animación: queda la grilla quieta y no se activa nada. -->
<script is:inline>
  (function () {
    const vp = document.querySelector('.footer-marcas');
    const track = vp && vp.querySelector('.footer-marcas-track');
    if (!vp || !track || !track.getAnimations) return;
    const anim = track.getAnimations().find((a) => a.animationName === 'marcas-desplazar');
    if (!anim) return;

    let sobre = false;       // mouse encima
    let foco = false;        // foco de teclado adentro
    let arrastrando = false;
    let movio = false;       // hubo arrastre: el click siguiente no navega
    let inicio = null;       // { id, x, t }

    const duracion = () => Number(anim.effect.getTiming().duration) || 1;
    const periodo = () => track.scrollWidth / 2 || 1; // px que recorre la animación (-50%)
    const actualizar = () => (arrastrando || sobre || foco ? anim.pause() : anim.play());

    vp.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { sobre = true; actualizar(); } });
    vp.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { sobre = false; actualizar(); } });
    // Solo el foco de teclado pausa: el foco que deja un click/arrastre con
    // el mouse sobre un logo no debe dejar el carrusel detenido.
    vp.addEventListener('focusin', (e) => { foco = e.target.matches(':focus-visible'); actualizar(); });
    vp.addEventListener('focusout', (e) => { if (!vp.contains(e.relatedTarget)) { foco = false; actualizar(); } });

    vp.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      inicio = { id: e.pointerId, x: e.clientX, t: Number(anim.currentTime) || 0 };
      movio = false;
    });
    vp.addEventListener('pointermove', (e) => {
      if (!inicio || e.pointerId !== inicio.id) return;
      const dx = e.clientX - inicio.x;
      if (!arrastrando) {
        if (Math.abs(dx) < 6) return; // umbral: por debajo es un click
        arrastrando = true;
        movio = true;
        vp.setPointerCapture(e.pointerId);
        vp.classList.add('is-arrastrando');
        actualizar();
      }
      // Arrastrar a la derecha mueve la tira a la derecha = retroceder la animación
      const d = duracion();
      const t = inicio.t - (dx / periodo()) * d;
      anim.currentTime = ((t % d) + d) % d;
    });
    const soltar = (e) => {
      if (!inicio || e.pointerId !== inicio.id) return;
      inicio = null;
      if (!arrastrando) return;
      arrastrando = false;
      vp.classList.remove('is-arrastrando');
      actualizar(); // con mouse sigue en pausa mientras esté encima (hover)
    };
    vp.addEventListener('pointerup', soltar);
    vp.addEventListener('pointercancel', soltar);

    // Un arrastre no dispara el link del logo; un click simple sí.
    vp.addEventListener('click', (e) => {
      if (movio) { e.preventDefault(); e.stopPropagation(); movio = false; }
    }, true);
    vp.addEventListener('dragstart', (e) => e.preventDefault());
  })();
</script>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { productos } from '../data/productos.js';
// Fuentes self-hosted (Fontsource, variables, font-display: swap)
import '@fontsource-variable/space-grotesk'; // Display / títulos
import '@fontsource-variable/inter';         // Cuerpo
import '@fontsource-variable/jetbrains-mono'; // Datos / specs / códigos
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  /** Nav oculto al cargar, con reveal al pasar la sección #hero (index y /nosotros). */
  navReveal?: boolean;
  /** Excluye la página de buscadores (404, /gracias/). */
  noindex?: boolean;
}

const {
  title = 'Resistencias Eléctricas Industriales | TAREWA Argentina',
  description = 'TAREWA: fabricantes de resistencias eléctricas industriales en Buenos Aires, Argentina. +60 años de experiencia y envíos a todo el país. Pedí tu presupuesto.',
  canonical = 'https://tarewa.com/',
  ogImage = 'https://tarewa.com/og/tarewa.jpg',
  navReveal = false,
  noindex = false,
} = Astro.props;
// Las og:image generadas (src/pages/og/) son siempre JPG 1200×630: se declaran
// las medidas para que Facebook/WhatsApp las muestren ya en el primer share.
const ogGenerada = ogImage.startsWith('https://tarewa.com/og/');
---

<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {ogGenerada && (
    <>
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )}
  <meta property="og:locale" content="es_AR" />
  <meta property="og:site_name" content="TAREWA" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "TAREWA",
    "description": "Fabricantes de resistencias eléctricas industriales con más de 60 años de experiencia.",
    "url": "https://tarewa.com",
    "logo": "https://tarewa.com/assets/logo.png",
    "image": "https://tarewa.com/assets/logo.png",
    "telephone": "+5491141937728",
    "email": "ventas@tarewa.com",
    "foundingDate": "1964",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Huaura 235",
      "addressLocality": "Buenos Aires",
      "addressRegion": "Buenos Aires",
      "postalCode": "1708",
      "addressCountry": "AR"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "16:30"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Resistencias Eléctricas",
      "itemListElement": productos.map((p) => (
        {"@type": "Offer","itemOffered": {"@type": "Product","name": p.nombre}}
      ))
    },
    "sameAs": [
      "https://www.linkedin.com/company/tarewa",
      "https://www.facebook.com/Tarewa1964"
    ]
  })} />

  <!-- Favicon (generado en build, ver src/lib/imagenes.js): WebP 32×32 como
       principal (~1 KB); .ico 16/32/48 de respaldo para navegadores viejos y
       buscadores. El sizes="48x48" del .ico hace que los navegadores modernos
       elijan el WebP para la pestaña. -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/webp" sizes="32x32" href="/favicon-32.webp" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Tipografías self-hosted (Fontsource) importadas en el frontmatter del layout -->

  <!-- Google tag de Google Ads (conversiones y remarketing; mismo ID que el
       WordPress anterior). Solo en el build de producción. Para sumar GA4,
       agregar gtag('config', 'G-XXXXXXX') debajo del config de Ads. -->
  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-1040136013"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-1040136013');
      </script>
    </>
  )}
</head>
<body>

  <Header reveal={navReveal} />

  <slot />

  <Footer />

  <!-- VOLVER ARRIBA -->
  <button class="back-to-top" id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Volver arriba">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <WhatsAppButton />

  <script is:inline>
    // Logo: fallback a texto si no existe assets/logo.avif
    const logoImg = document.getElementById('nav-logo-img');
    const logoText = document.getElementById('nav-logo-text');
    if (logoImg) {
      logoImg.onerror = function() {
        logoImg.style.display = 'none';
        if (logoText) logoText.style.display = 'block';
      };
    }

    // Nav shrink on scroll
    const navbar = document.getElementById('navbar');
    const backToTop = document.getElementById('backToTop');
    window.addEventListener('scroll', () => {
      if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 60);
      if (backToTop) backToTop.classList.toggle('visible', window.scrollY > 400);
    });

    // Nav oculto con reveal al scroll (páginas con data-reveal, index y /nosotros):
    // arranca oculto sobre el hero de slides y aparece al pasarlo. Progresivo:
    // la clase .nav-reveal sólo la agrega JS — sin JS el nav queda visible normal.
    // IntersectionObserver sobre #hero (sin listeners de scroll extra).
    if (navbar && navbar.dataset.reveal === 'true' && 'IntersectionObserver' in window) {
      const heroSec = document.querySelector('#hero');
      if (heroSec) {
        navbar.classList.add('nav-reveal');
        new IntersectionObserver((entries) => {
          const revealed = !entries[0].isIntersecting;
          navbar.classList.toggle('is-revealed', revealed);
          // Si vuelve a ocultarse con el menú mobile abierto, se cierra
          // (no queda un panel invisible con aria-expanded="true").
          if (!revealed && navbar.classList.contains('nav-open')) closeMenu();
        }, { threshold: 0 }).observe(heroSec);
      }
    }

    // Hamburger menu
    const hamburger = document.getElementById('navHamburger');
    const mobilePanel = document.getElementById('navMobilePanel');

    function openMenu() {
      hamburger.classList.add('is-open');
      navbar.classList.add('nav-open');
      hamburger.setAttribute('aria-expanded', 'true');
      hamburger.setAttribute('aria-label', 'Cerrar menú');
      mobilePanel.setAttribute('aria-hidden', 'false');
    }

    function closeMenu() {
      hamburger.classList.remove('is-open');
      navbar.classList.remove('nav-open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'Abrir menú');
      mobilePanel.setAttribute('aria-hidden', 'true');
    }

    if (hamburger && mobilePanel) {
      hamburger.addEventListener('click', () => {
        hamburger.classList.contains('is-open') ? closeMenu() : openMenu();
      });

      // Close on link click (smooth scroll + close)
      mobilePanel.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (navbar.classList.contains('nav-open') && !navbar.contains(e.target)) {
          closeMenu();
        }
      });

      // Close when resizing to desktop width
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 900) closeMenu();
      });
    }

    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Fallback SVG para imágenes sin foto
    document.querySelectorAll('.producto-img').forEach(div => {
      const svg = div.querySelector('svg');
      if (svg) svg.style.display = 'block';
    });

    // Form submit: lo recibe public/enviar-consulta.php (PHP del hosting), que
    // manda el mail a ventas@tarewa.com. Si sale bien, lleva a /gracias/
    // (página de conversión de Google Ads). Sin JS, el form hace el POST normal.
    async function handleSubmit(e) {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('.btn-form');
      const estado = form.querySelector('.form-estado');
      if (btn.disabled) return;
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      if (estado) estado.hidden = true;

      let error = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (data.ok) {
          btn.textContent = '¡Enviado!';
          btn.classList.add('is-sent');
          window.location.assign('/gracias/');
          return;
        }
        error = data.error || '';
      } catch (err) {
        // Sin conexión o servidor caído: mensaje genérico.
      }

      btn.disabled = false;
      btn.textContent = 'Enviar consulta';
      if (estado) {
        estado.textContent = error || 'No pudimos enviar tu consulta. Probá de nuevo o escribinos a ventas@tarewa.com.';
        estado.hidden = false;
      }
    }
    // Exponer la función al scope global para el atributo inline onsubmit
    window.handleSubmit = handleSubmit;
  </script>

</body>
</html>
